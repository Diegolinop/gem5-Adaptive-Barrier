@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""Executa a matriz mínima do Projeto 2 e registra cada comando em JSONL."""
+import argparse
+import itertools
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+
+def combinations(stage="main"):
+    if stage == "smoke":
+        for program, algorithm, threads in itertools.product(
+                ("micro", "jacobi", "integ"), ("central", "dissem", "auto"), (1, 2, 4, 8, 16)):
+            yield program, algorithm, threads, 19, 0.0, 1, "timing"
+        return
+    if stage == "o3":
+        for program, algorithm, threads, perturb in itertools.product(
+                ("micro", "jacobi"), ("central", "dissem"), (4, 16), (1, 2, 3)):
+            yield program, algorithm, threads, 1000 if program == "micro" else 512, 0.0, perturb, "o3"
+        return
+    if stage == "auto":
+        for threads, perturb in itertools.product((1, 2, 4, 8, 16), (1, 2, 3)):
+            yield "jacobi", "auto", threads, 512, 0.0, perturb, "timing"
+        return
+    for algorithm, threads, perturb in itertools.product(("central", "dissem"), (1, 2, 4, 8, 16), (1, 2, 3)):
+        for work, imbalance in itertools.product((0, 1000, 10000), (0.0, 0.5)):
+            yield "micro", algorithm, threads, work, imbalance, perturb, "timing"
+        for size in (128, 512):
+            yield "jacobi", algorithm, threads, size, 0.0, perturb, "timing"
+        yield "integ", algorithm, threads, 10000, 0.0, perturb, "timing"
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("gem5", type=Path)
+    parser.add_argument("--out", type=Path, default=Path("m5out/p02"))
+    parser.add_argument("--limiar", type=int)
+    parser.add_argument("--stage", choices=("main", "o3", "auto", "smoke"), default="main")
+    parser.add_argument("--iters", type=int, default=100)
+    parser.add_argument("--timeout", type=int, default=1200)
+    parser.add_argument("--dry-run", action="store_true")
+    args = parser.parse_args()
+    if args.iters <= 0 or args.timeout <= 0 or (args.limiar is not None and args.limiar <= 0):
+        parser.error("iterações, timeout e limiar devem ser positivos")
+    if args.stage in ("auto", "smoke") and args.limiar is None:
+        parser.error("informe --limiar (medido para a campanha auto)")
+    threshold = args.limiar or 1  # Não é usado pelos algoritmos fixos.
+    script = Path(__file__).with_name("sistema_p02.py")
+    args.out.mkdir(parents=True, exist_ok=True)
+    log = args.out / "commands.jsonl"
+    with log.open("w") as output:
+        for index, (program, algorithm, threads, work, imbalance, perturb, cpu) in enumerate(combinations(args.stage)):
+            run = args.out / f"{args.stage}-{index:03d}-{program}-{algorithm}-p{threads}-w{work}-s{perturb}"
+            command = [str(args.gem5), "-d", str(run), str(script), "--threads", str(threads),
+                       "--alg", algorithm, "--limiar", str(threshold), "--prog", program,
+                       "--work", str(work), "--imbalance", str(imbalance), "--iters", str(args.iters),
+                       "--perturb", str(perturb), "--cpu", cpu]
+            output.write(json.dumps({"dir": str(run), "command": command}) + "\n")
+            output.flush()
+            if not args.dry_run:
+                run.mkdir(parents=True, exist_ok=False)
+                binary = script.resolve().parents[3] / "workloads/p02" / program
+                reference_command = [str(binary), "--threads", str(threads), "--iters", str(args.iters),
+                                     "--work", str(work), "--imbalance", str(imbalance),
+                                     "--perturb", str(perturb), "--sequential", "1"]
+                reference_output = subprocess.check_output(reference_command, text=True, timeout=args.timeout)
+                reference = next(line.split(":", 1)[1].strip() for line in reference_output.splitlines()
+                                 if line.startswith("Resultado:"))
+                (run / "run.json").write_text(json.dumps(dict(program=program, algorithm=algorithm,
+                    threads=threads, work=work, imbalance=imbalance, perturb=perturb, cpu=cpu,
+                    iters=args.iters, threshold=threshold, reference=reference)))
+                with (run / "stdout.txt").open("w") as stdout, (run / "stderr.txt").open("w") as stderr:
+                    subprocess.run(command, check=True, stdout=stdout, stderr=stderr, timeout=args.timeout)
+        if not args.dry_run:
+            subprocess.run([sys.executable, str(script.with_name("extrai_p02.py")),
+                            str(args.out), "--csv", str(args.out / "results.csv")], check=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/configs/projetos/p02/extrai_p02.py b/configs/projetos/p02/extrai_p02.py
new file mode 100644
index 0000000000..86c158e3cb
--- /dev/null
+++ b/configs/projetos/p02/extrai_p02.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Extrai métricas e reprova execuções cujo monitor detectou erro."""
+import argparse
+import csv
+import json
+import math
+import re
+from pathlib import Path
+
+
+def read_stats(path):
+    stats = {}
+    inside = False
+    for line in path.read_text(errors="replace").splitlines():
+        if "Begin Simulation Statistics" in line:
+            inside = True
+            continue
+        if inside and "End Simulation Statistics" in line:
+            return stats
+        fields = line.split()
+        if inside and len(fields) >= 2 and not line.lstrip().startswith("#"):
+            stats[fields[0]] = float(fields[1])
+    raise ValueError(f"ROI sem bloco completo: {path}")
+
+
+def value(stats, suffix):
+    return sum(number for name, number in stats.items() if name.endswith(suffix))
+
+
+def result(text):
+    return next(line.split(":", 1)[1].strip() for line in text.splitlines()
+                if line.startswith("Resultado:"))
+
+
+def extract(path):
+    stats = read_stats(path)
+    meta = json.loads((path.parent / "run.json").read_text())
+    output = (path.parent / "stdout.txt").read_text()
+    episodes = meta["iters"] * (2 if meta["program"] == "integ" else 1)
+    monitor = "system.barrier_monitor."
+    arrivals = [v for k, v in stats.items()
+                if k == monitor + "arrivals" or k.startswith(monitor + "arrivals::")]
+    completed = sum(v for k, v in stats.items()
+                    if k.startswith(monitor + "barriersCompleted::")
+                    and k.rsplit("::", 1)[1] not in ("0", "total"))
+    errors = []
+    if result(output) != meta["reference"]:
+        errors.append("resultado difere da referência sequencial")
+    declared = re.search(r"Episódios medidos: (\d+)", output)
+    if not declared or int(declared[1]) != episodes or completed != episodes:
+        errors.append("contagem de episódios incorreta")
+    if len(arrivals) != meta["threads"] or any(v != episodes for v in arrivals):
+        errors.append("chegadas por contexto incorretas")
+    for key in ("earlyDepartures", "invalidEvents"):
+        if stats.get(monitor + key) != 0:
+            errors.append(key)
+    if stats.get(monitor + "releaseLatency::samples") != episodes:
+        errors.append("amostras de liberação incorretas")
+    ticks = stats["simTicks"]
+    if not math.isfinite(ticks) or ticks <= 0:
+        errors.append("tempo da ROI inválido")
+    l1_rmw = sum(v for k, v in stats.items()
+                 if re.fullmatch(r"system\.cpu\d*\.dcache\.lockedRMWs::total", k))
+    corrected_rmw = l1_rmw - 2 * meta["threads"]
+    selected = meta["algorithm"]
+    if selected == "auto":
+        selected = "dissem" if meta["threads"] >= meta["threshold"] else "central"
+    expected_rmw = episodes * meta["threads"] if selected == "central" else 0
+    if corrected_rmw != expected_rmw:
+        errors.append("RMWs L1 incompatíveis com o algoritmo")
+    row = {"run": path.parent.name, **meta, "valid": int(not errors),
+           "errors": "; ".join(errors), "sim_ticks": ticks,
+           "ticks_per_iteration": ticks / meta["iters"], "episodes": completed,
+           "l1_rmws_per_episode": corrected_rmw / episodes,
+           "l2_rmws_per_episode": value(stats, "l2.lockedRMWs::total") / episodes,
+           "l1_invalidations_per_episode": sum(v for k, v in stats.items()
+                if re.fullmatch(r"system\.cpu\d*\.dcache\.snoopInvalidations", k)) / episodes,
+           "l1d_misses_per_episode": sum(v for k, v in stats.items()
+                if re.fullmatch(r"system\.cpu\d*\.dcache\.overallMisses::total", k)) / episodes,
+           "wait_fraction": sum(v for k, v in stats.items()
+                if k == monitor + "waitTicks" or k.startswith(monitor + "waitTicks::"))
+                / (meta["threads"] * ticks)}
+    for key in ("releaseLatency", "arrivalSpread", "waitDist"):
+        row[key + "_mean"] = stats.get(monitor + key + "::mean", float("nan"))
+    return row
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("root", type=Path)
+    parser.add_argument("--csv", type=Path, default=Path("p02.csv"))
+    args = parser.parse_args()
+    rows = []
+    for metadata in sorted(args.root.glob("*/run.json")):
+        path = metadata.parent / "stats.txt"
+        try:
+            rows.append(extract(path))
+        except (ValueError, KeyError, OSError, StopIteration) as error:
+            rows.append({"run": path.parent.name, "valid": 0, "errors": str(error)})
+    if not rows:
+        raise SystemExit("nenhuma execução encontrada")
+    baselines = {(r["program"], r["algorithm"], r["work"], r["imbalance"],
+                  r["perturb"], r["cpu"], r["iters"]): r["sim_ticks"]
+                 for r in rows if r["valid"] and r["threads"] == 1}
+    for row in rows:
+        if row["valid"]:
+            baseline = baselines.get(tuple(row[k] for k in
+                ("program", "algorithm", "work", "imbalance", "perturb", "cpu", "iters")))
+            if baseline is not None:
+                row["speedup_p1"] = baseline / row["sim_ticks"]
+                row["efficiency_p1"] = row["speedup_p1"] / row["threads"]
+    with args.csv.open("w", newline="") as output:
+        fields = list(dict.fromkeys(key for row in rows for key in row))
+        writer = csv.DictWriter(output, fieldnames=fields)
+        writer.writeheader()
+        writer.writerows(rows)
+    if any(not row["valid"] for row in rows):
+        raise SystemExit("há execuções inválidas; consulte o CSV")
+
+
+if __name__ == "__main__":
+    main()
