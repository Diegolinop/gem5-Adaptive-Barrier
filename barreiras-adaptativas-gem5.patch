+"""python3 configs/projetos/p02/test_extrai_p02.py"""
+import json
+import tempfile
+from pathlib import Path
+
+from extrai_p02 import extract, read_stats
+
+
+with tempfile.TemporaryDirectory() as directory:
+    root = Path(directory)
+    meta = dict(program="micro", threads=2, iters=3, algorithm="dissem",
