diff --git a/workloads/p02/test_workloads.py b/workloads/p02/test_workloads.py
new file mode 100644
index 0000000000..37dbe050ab
--- /dev/null
+++ b/workloads/p02/test_workloads.py
@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+"""Run with python3 workloads/p02/test_workloads.py (native, no m5ops)."""
+import subprocess
+import math
+import tempfile
+from pathlib import Path
+
+
+SOURCE = Path(__file__).resolve().parent
+
+
+def result(command):
+    output = subprocess.check_output(command, text=True, timeout=30)
+    return next(line for line in output.splitlines() if line.startswith("Resultado:"))
+
+
+with tempfile.TemporaryDirectory() as directory:
+    cases = 0
+    for program in ("micro", "jacobi", "integ"):
+        binary = str(Path(directory) / program)
+        subprocess.run(["g++", "-O2", "-std=c++17", "-pthread",
+                        "-I" + str(SOURCE.parents[1] / "include"),
+                        *[str(SOURCE / (name + ".cc")) for name in
+                          (program, "barreira", "central", "dissem")], "-o", binary], check=True)
+        if program == "integ":
+            actual = float(result([binary, "--sequential", "1", "--threads", "1",
+                                   "--iters", "1", "--work", "10000"]).split(":")[1])
+            assert math.isclose(actual, math.pi, abs_tol=1e-8)
+        if program == "jacobi":
+            assert result([binary, "--sequential", "1", "--work", "3", "--iters", "2"]) == "Resultado: 900"
+        for threads in (1, 2, 3, 4, 8, 16):
+            for iterations in (3, 4):
+                command = [binary, "--threads", str(threads), "--iters", str(iterations),
+                           "--work", "19", "--perturb", "2", "--imbalance", "0.5",
+                           "--limiar", "4"]
+                expected = result(command + ["--sequential", "1"])
+                for algorithm in ("central", "dissem", "auto"):
+                    assert result(command + ["--alg", algorithm]) == expected
+                    cases += 1
+    print(f"{cases} native workload cases match sequential references")
