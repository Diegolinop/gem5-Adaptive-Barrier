+/* Etapa 04 */
+
+#pragma once
+#include "barreira.h"
+
+class CentralBarrier : public Barrier
+{
+  public:
+    CentralBarrier(unsigned numParticipants, uint64_t id);
+
+  protected:
+    void waitImpl(unsigned tid) override
+    {
+        // Inverte o sentido
+        localSense[tid].value = 1 - localSense[tid].value;
+
+        // Decrementa o contador
+        unsigned previous = counter.fetch_sub(
+            1, std::memory_order_acq_rel
+        );
+
+        if (previous == 1) {
+            // Restaura o contador
+            counter.store(numParticipants, std::memory_order_relaxed);
+            sense.store(localSense[tid].value, std::memory_order_release);
+        } else {
+            // Espera até observar o sentido deste episódio.
+            while (sense.load(std::memory_order_acquire) != localSense[tid].value) { }
+        }
+    }
+
+  private:
+    alignas(CACHE_LINE) std::atomic<unsigned> counter;
+    alignas(CACHE_LINE) std::atomic<unsigned> sense;
+
+    struct alignas(CACHE_LINE) ThreadSense
+    {
+        unsigned value = 0;
+    };
+
+    std::unique_ptr<ThreadSense[]> localSense;
+};
diff --git a/workloads/p02/dissem.cc b/workloads/p02/dissem.cc
new file mode 100644
index 0000000000..d89a05e360
--- /dev/null
+++ b/workloads/p02/dissem.cc
@@ -0,0 +1,61 @@
+/* Etapa 05 */
+
+#include "dissem.h"
+
+DisseminationBarrier::DisseminationBarrier(unsigned numParticipants, uint64_t id)
+    : Barrier(numParticipants, id),
+      rounds(0),
+      threads(numParticipants)
+{
+    uint64_t distance = 1;
+
+    while (distance < numParticipants) {
+        rounds++;
+        distance *= 2;
+    }
+
+    for (unsigned tid = 0; tid < numParticipants; tid++) {
+        ThreadData &thread = threads[tid];
+
+        for (unsigned parity = 0; parity < 2; parity++) {
+            thread.flags[parity] = std::make_unique<Flag[]>(rounds);
+            thread.partners[parity].resize(rounds);
+        }
+    }
+
+    for (unsigned tid = 0; tid < numParticipants; tid++) {
+        ThreadData &thread = threads[tid];
+        distance = 1;
+
+        for (unsigned round = 0; round < rounds; round++) {
+            unsigned partner = (tid + distance) % numParticipants;
+
+            for (unsigned parity = 0; parity < 2; parity++) {
+                thread.partners[parity][round] = &threads[partner].flags[parity][round];
+            }
+
+            distance *= 2;
+        }
+    }
+}
+
+void DisseminationBarrier::waitImpl(unsigned tid)
+{
+    ThreadData &thread = threads[tid];
+    unsigned parity = thread.parity;
+
+    for (unsigned round = 0; round < rounds; round++) {
+        Flag *partner = thread.partners[parity][round];
+        Flag &flag = thread.flags[parity][round];
+
+        (*partner).value.store(thread.sense, std::memory_order_release);
+
+        while (flag.value.load(std::memory_order_acquire) != thread.sense) { }
+    }
+
+    if (parity == 1) {
+        thread.sense = 1 - thread.sense;
+    }
+
+    thread.parity = 1 - parity;
+}
