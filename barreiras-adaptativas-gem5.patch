+/* Etapa 05 */
+
+#pragma once
+#include <vector>
+#include "barreira.h"
+
+class DisseminationBarrier : public Barrier
+{
+  public:
+    DisseminationBarrier(unsigned numParticipants, uint64_t id);
+
+  protected:
+    void waitImpl(unsigned tid) override;
+
+  private:
+    struct alignas(CACHE_LINE) Flag
+    {
+        std::atomic<unsigned> value{0};
+    };
+
+    struct alignas(CACHE_LINE) ThreadData
+    {
+        std::unique_ptr<Flag[]> flags[2];
+        std::vector<Flag *> partners[2];
+
+        unsigned parity = 0;
+        unsigned sense = 1;
+    };
+
+    unsigned rounds;
+    std::vector<ThreadData> threads;
+};
diff --git a/workloads/p02/integ.cc b/workloads/p02/integ.cc
new file mode 100644
index 0000000000..7f6261b812
--- /dev/null
+++ b/workloads/p02/integ.cc
@@ -0,0 +1,91 @@
+#include <cstdint>
+#include <iostream>
+#include <iomanip>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "barreira.h"
+#include "central.h"
+#include "perturb.h"
+
+struct Params { unsigned threads = 4, iters = 100, work = 10000, threshold = 8; uint64_t seed = 0; bool sequential = false; Algorithm algorithm = Algorithm::Central; };
+
+static bool parse(Params &p, int argc, char **argv)
+{
+    for (int i = 1; i < argc; i += 2) {
+        if (i + 1 == argc) return false;
+        std::string key(argv[i]), value(argv[i + 1]);
+        if (key == "--threads") p.threads = std::stoul(value);
+        else if (key == "--iters") p.iters = std::stoul(value);
+        else if (key == "--work") p.work = std::stoul(value);
+        else if (key == "--limiar") p.threshold = std::stoul(value);
+        else if (key == "--sequential") p.sequential = value == "1";
+        else if (key == "--perturb") p.seed = std::stoull(value);
+        else if (key == "--alg") p.algorithm = value == "central" ? Algorithm::Central : value == "dissem" ? Algorithm::Dissem : Algorithm::Auto;
+        else if (key != "--imbalance" && key != "--perturb") return false;
+    }
+    return p.threads && p.iters && p.work && (p.algorithm != Algorithm::Auto || p.threshold);
+}
+
+int main(int argc, char **argv)
+{
+    Params p;
+    if (!parse(p, argc, argv)) return 1;
+    auto measured = createBarrier(p.algorithm, p.threads, 1, p.threshold);
+    auto control = std::make_unique<CentralBarrier>(p.threads, P02_BARRIER_CTRL);
+    struct alignas(CACHE_LINE) Partial { double value = 0; };
+    std::vector<Partial> partial(p.threads);
+    double parameter = 1.0, result = 0.0;
+    auto integrate = [&](unsigned tid) {
+        double sum = 0.0;
+        const double step = 1.0 / p.work;
+        for (uint64_t i = uint64_t(p.work) * tid / p.threads;
+             i < uint64_t(p.work) * (tid + 1) / p.threads; ++i) {
+            const double x = (i + 0.5) * step;
+            sum += 4.0 / (1.0 + parameter * x * x);
+        }
+        partial[tid].value = sum * step;
+    };
+    auto combine = [&] {
+        double integral = 0.0;
+        for (const auto &value : partial) integral += value.value;
+        result += integral;
+        parameter = 1.0 + integral / 4.0;
+    };
+    if (p.sequential) {
+        for (unsigned it = 0; it < p.iters; ++it) {
+            for (unsigned tid = 0; tid < p.threads; ++tid) integrate(tid);
+            combine();
+        }
+        std::cout << "Resultado: " << std::setprecision(17) << result << "\n";
+        return 0;
+    }
+    std::atomic<bool> roiReady{false};
+    auto worker = [&](unsigned tid) {
+        initialDelay(p.seed, tid);
+        control->wait(tid);
+#ifdef USE_M5OPS
+        if (tid == 0) m5_reset_stats(0, 0);
+#endif
+        if (tid == 0) roiReady.store(true, std::memory_order_release);
+        while (!roiReady.load(std::memory_order_acquire)) { }
+        control->wait(tid);
+        for (unsigned it = 0; it < p.iters; ++it) {
+            integrate(tid);
+            measured->wait(tid);
+            if (tid == 0) combine();
+            measured->wait(tid);
+        }
+        control->wait(tid);
+#ifdef USE_M5OPS
+        if (tid == 0) m5_dump_stats(0, 0);
+#endif
+    };
+    std::vector<std::thread> workers;
+    for (unsigned tid = 1; tid < p.threads; ++tid) workers.emplace_back(worker, tid);
+    worker(0);
+    for (auto &thread : workers) thread.join();
+    std::cout << "Resultado: " << std::setprecision(17) << result << "\nEpisódios medidos: " << 2 * p.iters << "\n";
+}
diff --git a/workloads/p02/jacobi.cc b/workloads/p02/jacobi.cc
new file mode 100644
index 0000000000..f0868debaa
--- /dev/null
+++ b/workloads/p02/jacobi.cc
@@ -0,0 +1,105 @@
+#include <algorithm>
+#include <cstdint>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "barreira.h"
+#include "central.h"
+#include "perturb.h"
+
+struct Params {
+    unsigned threads = 4, iters = 20, size = 128, threshold = 8;
+    Algorithm algorithm = Algorithm::Central;
+    bool sequential = false;
+    uint64_t seed = 0;
+};
+
+static bool parse(Params &p, int argc, char **argv)
+{
+    for (int i = 1; i < argc; i += 2) {
+        if (i + 1 == argc) return false;
+        std::string key(argv[i]), value(argv[i + 1]);
+        if (key == "--threads") p.threads = std::stoul(value);
+        else if (key == "--iters") p.iters = std::stoul(value);
+        else if (key == "--work") p.size = std::stoul(value);
+        else if (key == "--limiar") p.threshold = std::stoul(value);
+        else if (key == "--sequential") p.sequential = value == "1";
+        else if (key == "--perturb") p.seed = std::stoull(value);
+        else if (key == "--alg") {
+            p.algorithm = value == "central" ? Algorithm::Central :
+                          value == "dissem" ? Algorithm::Dissem : Algorithm::Auto;
+        } else if (key != "--imbalance" && key != "--perturb") return false;
+    }
+    return p.threads && p.iters && p.size >= 3 &&
+           (p.algorithm != Algorithm::Auto || p.threshold);
+}
+
+int main(int argc, char **argv)
+{
+    Params p;
+    if (!parse(p, argc, argv)) return 1;
+    const size_t cells = size_t(p.size) * p.size;
+    const size_t offset = (p.seed % 8) * CACHE_LINE / sizeof(uint64_t);
+    std::vector<uint64_t> storageA(cells + offset, 1), storageB(cells + offset, 1);
+    auto *a = storageA.data() + offset;
+    auto *b = storageB.data() + offset;
+    for (unsigned x = 0; x < p.size; ++x)
+        a[x] = a[cells - p.size + x] = a[size_t(x) * p.size] = a[size_t(x + 1) * p.size - 1] = 100;
+    std::copy(a, a + cells, b);
+
+    if (p.sequential) {
+        for (unsigned it = 0; it < p.iters; ++it) {
+            for (unsigned y = 1; y + 1 < p.size; ++y)
+                for (unsigned x = 1; x + 1 < p.size; ++x) {
+                    const size_t k = size_t(y) * p.size + x;
+                    b[k] = (a[k - p.size] + a[k + p.size] + a[k - 1] + a[k + 1]) / 4;
+                }
+            std::swap(a, b);
+        }
+        uint64_t checksum = 0;
+        for (size_t k = 0; k < cells; ++k) checksum += a[k];
+        std::cout << "Resultado: " << checksum << "\n";
+        return 0;
+    }
+
+    auto measured = createBarrier(p.algorithm, p.threads, 1, p.threshold);
+    CentralBarrier control(p.threads, P02_BARRIER_CTRL);
+    std::atomic<bool> roiReady{false};
+    auto worker = [&](unsigned tid) {
+        initialDelay(p.seed, tid);
+        auto *current = a;
+        auto *next = b;
+        const unsigned first = 1 + (p.size - 2) * tid / p.threads;
+        const unsigned last = 1 + (p.size - 2) * (tid + 1) / p.threads;
+        control.wait(tid);
+#ifdef USE_M5OPS
+        if (tid == 0) m5_reset_stats(0, 0);
+#endif
+        if (tid == 0) roiReady.store(true, std::memory_order_release);
+        while (!roiReady.load(std::memory_order_acquire)) { }
+        control.wait(tid);
+        for (unsigned it = 0; it < p.iters; ++it) {
+            for (unsigned y = first; y < last; ++y)
+                for (unsigned x = 1; x + 1 < p.size; ++x)
+                    next[size_t(y) * p.size + x] = (current[size_t(y - 1) * p.size + x] +
+                        current[size_t(y + 1) * p.size + x] + current[size_t(y) * p.size + x - 1] +
+                        current[size_t(y) * p.size + x + 1]) / 4;
+            measured->wait(tid);
+            std::swap(current, next);
+        }
+        control.wait(tid);
+#ifdef USE_M5OPS
+        if (tid == 0) m5_dump_stats(0, 0);
+#endif
+    };
+    std::vector<std::thread> workers;
+    for (unsigned tid = 1; tid < p.threads; ++tid) workers.emplace_back(worker, tid);
+    worker(0);
+    for (auto &thread : workers) thread.join();
+    uint64_t checksum = 0;
+    for (size_t k = 0; k < cells; ++k) checksum += (p.iters % 2 ? b : a)[k];
+    std::cout << "Resultado: " << checksum << "\nEpisódios medidos: " << p.iters << "\n";
+}
diff --git a/workloads/p02/micro.cc b/workloads/p02/micro.cc
new file mode 100644
index 0000000000..25df1c5af5
--- /dev/null
+++ b/workloads/p02/micro.cc
@@ -0,0 +1,239 @@
+/* Listagem 11.13 */
+/* 11.9 */
+
+#include <cstdint>
+#include <iostream>
+#include <random>
+#include <thread>
+#include <vector>
+#include <functional>
+#include <sstream>
+#include <string>
+#include "central.h"
+#include "perturb.h"
+
+struct Params
+{
+    unsigned numThreads = 4;
+    unsigned iterations = 100;
+    unsigned warmup = 10;
+
+    uint64_t work = 1000;
+    double imbalance = 0.0;
+    uint64_t seed = 1;
+    Algorithm algorithm = Algorithm::Central;
+    unsigned threshold = 0;
+    bool sequential = false;
+};
+
+uint64_t
+syntheticWork(
+    unsigned tid,
+    const Params &params,
+    std::mt19937 &generator
+)
+{
+    uint64_t n = params.work;
+
+    if (params.imbalance > 0 && n > 0) {
+        std::uniform_real_distribution<double> distribution(0.0, 1.0);
+        double u = distribution(generator);
+        n += static_cast<uint64_t>(n * params.imbalance * u);
+    }
+
+    uint64_t acc = tid + 1;
+
+    for (uint64_t k = 0; k < n; k++) {
+        acc = acc * 3 + k;
+    }
+
+    return acc;
+}
+
+void participant(
+    unsigned tid,
+    const Params &params,
+    Barrier &measured,
+    Barrier &control,
+    std::atomic<bool> &roiReady,
+    uint64_t &result
+)
+{
+    std::mt19937 generator(params.seed + tid);
+    uint64_t total = 0;
+    initialDelay(params.seed, tid);
+
+    // Aquecimento
+    for (unsigned i = 0; i < params.warmup; i++) {
+        total += syntheticWork(tid, params, generator);
+        measured.wait(tid);
+    }
+
+    control.wait(tid);
+
+#ifdef USE_M5OPS
+    if (tid == 0) {
+        m5_reset_stats(0, 0);
+    }
+#endif
+
+    if (tid == 0) roiReady.store(true, std::memory_order_release);
+    while (!roiReady.load(std::memory_order_acquire)) { }
+    control.wait(tid);
+
+    // Região de interesse.
+    for (unsigned i = 0; i < params.iterations; i++) {
+        total += syntheticWork(tid, params, generator);
+        measured.wait(tid);
+    }
+
+    control.wait(tid);
+
+#ifdef USE_M5OPS
+    if (tid == 0) {
+        m5_dump_stats(0, 0);
+    }
+#endif
+
+    result = total;
+}
+
+int main(int argc, char *argv[])
+{
+    Params params;
+
+    for (int i = 1; i < argc; i += 2) {
+        std::string option = argv[i];
+
+        if (option == "--help") {
+            std::cout
+                << "Opções: --threads N --iters N --work N "
+                << "--imbalance F --perturb N "
+                << "--alg central|dissem|auto --limiar N\n";
+            return 0;
+        }
+
+        if (i + 1 >= argc) {
+            std::cerr << "Falta o valor de " << option << "\n";
+            return 1;
+        }
+
+        std::string text = argv[i + 1];
+
+        if (option == "--alg") {
+            if (text == "central") {
+                params.algorithm = Algorithm::Central;
+            } else if (text == "dissem") {
+                params.algorithm = Algorithm::Dissem;
+            } else if (text == "auto") {
+                params.algorithm = Algorithm::Auto;
+            } else {
+                std::cerr << "Algoritmo inválido: " << text << "\n";
+                return 1;
+            }
+
+            continue;
+        }
+
+        std::istringstream value(text);
+
+        if (text.empty() || text[0] == '-') {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+
+        if (option == "--threads") {
+            value >> params.numThreads;
+        } else if (option == "--iters") {
+            value >> params.iterations;
+        } else if (option == "--work") {
+            value >> params.work;
+        } else if (option == "--imbalance") {
+            value >> params.imbalance;
+        } else if (option == "--perturb") {
+            value >> params.seed;
+        } else if (option == "--limiar") {
+            value >> params.threshold;
+        } else if (option == "--sequential") {
+            value >> params.sequential;
+        } else {
+            std::cerr << "Opção desconhecida: " << option << "\n";
+            return 1;
+        }
+
+        if (value.fail() || !value.eof()) {
+            std::cerr << "Valor inválido para " << option << "\n";
+            return 1;
+        }
+    }
+
+    if (params.numThreads == 0 || params.iterations == 0) {
+        std::cerr << "Threads e iterações devem ser maiores que zero.\n";
+        return 1;
+    }
+
+    if (params.algorithm == Algorithm::Auto && params.threshold == 0) {
+        std::cerr << "Informe --limiar maior que zero para usar auto.\n";
+        return 1;
+    }
+
+    if (params.sequential) {
+        uint64_t total = 0;
+        for (unsigned tid = 0; tid < params.numThreads; ++tid) {
+            std::mt19937 generator(params.seed + tid);
+            for (unsigned i = 0; i < params.warmup + params.iterations; ++i)
+                total += syntheticWork(tid, params, generator);
+        }
+        std::cout << "Resultado: " << total << "\n";
+        return 0;
+    }
+
+    std::unique_ptr<Barrier> measured = createBarrier(
+        params.algorithm,
+        params.numThreads,
+        1,
+        params.threshold
+    );
+
+    if (!measured) {
+        std::cerr << "Não foi possível criar a barreira.\n";
+        return 1;
+    }
+
+    CentralBarrier control(params.numThreads, P02_BARRIER_CTRL);
+    std::atomic<bool> roiReady{false};
+
+    std::vector<uint64_t> results(params.numThreads, 0);
+    std::vector<std::thread> threads;
+
+    for (unsigned tid = 1; tid < params.numThreads; tid++) {
+        threads.emplace_back(
+            participant,
+            tid,
+            std::cref(params),
+            std::ref(*measured),
+            std::ref(control),
+            std::ref(roiReady),
+            std::ref(results[tid])
+        );
+    }
+
+    participant(0, params, *measured, control, roiReady, results[0]);
+
+    for (std::thread &thread : threads) {
+        thread.join();
+    }
+
+    uint64_t total = 0;
+
+    for (unsigned tid = 0; tid < params.numThreads; tid++) {
+        total += results[tid];
+    }
+
+    std::cout << "Threads: " << params.numThreads << "\n";
+    std::cout << "Iterações medidas: " << params.iterations << "\n";
+    std::cout << "Episódios medidos: " << params.iterations << "\n";
+    std::cout << "Resultado: " << total << "\n";
+
+    return 0;
+}
